PORT=3000
# AI provider (any OpenAI-compatible API). Defaults to xAI when AI_BASE_URL is unset.
# Groq free tier: AI_BASE_URL=https://api.groq.com/openai/v1  XAI_MODEL=openai/gpt-oss-120b
# AI_BASE_URL=
XAI_API_KEY=your_ai_provider_api_key_here
XAI_MODEL=grok-beta
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
NODE_ENV=development

# Production only: pin CORS to your published extension id (optional; otherwise any chrome-extension:// origin is allowed)
# EXTENSION_ID=

# Set to 1 when running behind a hosting reverse proxy (Render, Railway, Fly) so rate limiting sees real client IPs.
# TRUST_PROXY=1
