{
  "name": "@arzi-baaz/extension",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ng build --watch --configuration development",
    "build": "ng build --configuration production && node scripts/build-extension.mjs",
    "build:dev": "ng build --configuration development && node scripts/build-extension.mjs --dev",
    "lint": "ng lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\""
  },
  "dependencies": {
    "@angular/animations": "^19.1.3",
    "@angular/common": "^19.1.3",
    "@angular/compiler": "^19.1.3",
    "@angular/core": "^19.1.3",
    "@angular/forms": "^19.1.3",
    "@angular/platform-browser": "^19.1.3",
    "@angular/platform-browser-dynamic": "^19.1.3",
    "@angular/router": "^19.1.3",
    "@arzi-baaz/contracts": "workspace:*",
    "@supabase/supabase-js": "^2.47.12",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.1.5",
    "@angular/cli": "^19.1.5",
    "@angular/compiler-cli": "^19.1.3",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "angular-eslint": "^19.0.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.18.0",
    "typescript": "~5.8.3",
    "vitest": "^3.0.2"
  }
}
